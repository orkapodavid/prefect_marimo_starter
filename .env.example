# Environment overrides for Prefect Marimo Workflows
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_NAME="Prefect Marimo Workflows"

# Database connection (application DB)
DATABASE_URL=postgresql://localhost:5432/workflow_app
# For SQLite (legacy): DATABASE_URL=sqlite:///data/workflow.db
DB_POOL_SIZE=5

# Prefect setup
PREFECT_API_URL=http://localhost:4200/api
# WORK_POOL_NAME=windows-process-pool
# Prefect server database (set via `prefect config set` or env var)
# PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://localhost:5432/prefect_server

# Exchange Service
# EXCHANGE_USERNAME=domain\user
# EXCHANGE_PASSWORD=password
# EXCHANGE_EWS_URL=https://mail.domain.com/EWS/Exchange.asmx

# MS SQL Server Connection - DEV
DEV_MSSQL_SERVER=
DEV_MSSQL_DATABASE=
DEV_MSSQL_USERNAME=
DEV_MSSQL_PASSWORD=

# MS SQL Server Connection - PROD
PROD_MSSQL_SERVER=
PROD_MSSQL_DATABASE=
PROD_MSSQL_USERNAME=
PROD_MSSQL_PASSWORD=

# Paths
# DATA_DIRECTORY=./data
# LOG_DIRECTORY=./logs
# REPORTS_DIRECTORY=./reports

# Processing
BATCH_SIZE=1000
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=300

# Notifications
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL=admin@example.com
NOTIFY_ON_FAILURE=true
NOTIFY_ON_SUCCESS=false

# X Monitor
X_MONITOR_DATABASE_URL=postgresql://localhost:5432/x_monitor
# X_MONITOR_CONFIG_PATH=./config/x_monitor/x_monitor_targets.yaml
# X_MONITOR_WORKSPACE_DIR=./data/x_monitor
# X_MONITOR_TWSCRAPE_ACCOUNTS_DB=./data/x_monitor/twscrape/accounts.db
X_MONITOR_GMAIL_PROVIDER=gmail_smtp
X_MONITOR_GMAIL_SMTP_HOST=smtp.gmail.com
X_MONITOR_GMAIL_SMTP_PORT=587
X_MONITOR_GMAIL_SMTP_USERNAME=
X_MONITOR_GMAIL_SMTP_PASSWORD=
X_MONITOR_GMAIL_SMTP_FROM=
X_MONITOR_GMAIL_SMTP_USE_STARTTLS=true
X_MONITOR_GMAIL_API_CREDENTIALS_FILE=
X_MONITOR_GMAIL_API_TOKEN_FILE=
X_MONITOR_GMAIL_API_FROM=
X_MONITOR_GMAIL_API_USE_ADC=false
X_MONITOR_POLL_CRON=*/5 * * * *
X_MONITOR_DIGEST_CRON=0 8 * * *
X_MONITOR_HEALTH_CRON=*/30 * * * *
X_MONITOR_TIMEZONE=Asia/Singapore
X_MONITOR_POLL_BATCH_LIMIT=25
X_MONITOR_IMMEDIATE_ALERTS_ENABLED=true
X_MONITOR_DAILY_DIGEST_ENABLED=true
X_MONITOR_SUBJECT_PREFIX=[X Monitor]
X_MONITOR_OPERATOR_EMAILS=
X_MONITOR_CONSECUTIVE_FAILURE_THRESHOLD=3
